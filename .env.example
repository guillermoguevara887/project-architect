# MemoOS root environment example.
# Copy this file to .env only for local development. Do not commit real secrets.

# Local API port used by apps/api.
API_PORT=4000

# PostgreSQL connection string required by apps/api and db:migrate.
# Never expose this value with a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://memoos:memoos@localhost:5432/memoos

# Server-side rewrite target used by apps/web. In production this should point to the Railway API URL.
API_INTERNAL_URL=http://localhost:4000

# Runtime environment marker.
APP_ENV=local
NODE_ENV=development

# HMAC secret used by apps/api to sign HTTP-only session cookies.
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret

# Public frontend origin used to build password-reset links.
APP_URL=http://localhost:3000

# Server-only Resend configuration for account recovery email.
RESEND_API_KEY=re_replace-with-a-resend-api-key
PASSWORD_RESET_FROM_EMAIL=MemoOS <no-reply@example.com>

# Server-only OpenAI configuration for project text improvement.
OPENAI_API_KEY=replace-with-a-server-side-api-key
OPENAI_PROJECT_TEXT_MODEL=gpt-5.4-mini
