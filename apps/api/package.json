{
  "name": "@memoos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/local-server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx watch src/local-server.ts",
    "start": "node dist/local-server.js",
    "auth:create-user": "tsx src/auth/create-user.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.4.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3"
  }
}
