# Local backend port. Railway will usually provide PORT in production.
API_PORT=4000

# PostgreSQL connection string required by the API and migration command.
DATABASE_URL=postgresql://project_architect:project_architect@localhost:5432/project_architect

# Optional host override for local development.
API_HOST=0.0.0.0

# Runtime environment marker.
APP_ENV=local
NODE_ENV=development

# HMAC secret used to sign HTTP-only session cookies in production.
# Use a random value with at least 32 characters.
AUTH_COOKIE_SECRET=replace-with-a-long-random-secret

# Public frontend origin used to build password-reset links.
APP_URL=http://localhost:3000

# Server-only Resend configuration for account recovery email.
RESEND_API_KEY=re_replace-with-a-resend-api-key
PASSWORD_RESET_FROM_EMAIL=MemoOS <no-reply@example.com>

# Server-only OpenAI configuration for project text improvement.
OPENAI_API_KEY=replace-with-a-server-side-api-key
OPENAI_PROJECT_TEXT_MODEL=gpt-5.4-mini
